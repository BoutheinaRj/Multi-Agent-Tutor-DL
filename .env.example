# Copier ce fichier en .env et adapter les valeurs (.env est ignoré par Git).

# --- LLM 100 % local (agents/llm.py), voir docs/llm_local.md ---
# llamacpp (défaut) | transformers | fake (réponses déterministes, pour les tests)
LLM_BACKEND=llamacpp
# Fichier GGUF pour llamacpp (relatif à la racine du dépôt)
LLM_MODEL_PATH=models/qwen2.5-3b-instruct-q4_k_m.gguf
LLM_N_CTX=4096
# Threads CPU pour llamacpp (vide = automatique)
LLM_N_THREADS=
# Modèle pour transformers (lu dans le cache local uniquement, HF_HUB_OFFLINE=1)
LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
LLM_TEMPERATURE=0.2

# --- Agent Resources (A4) : catalogue local data/ressources/catalogue.json, aucune clé ---
